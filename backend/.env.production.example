# Production Environment Variables for Deployment

DJANGO_SECRET_KEY=your-generated-secret-key-here-change-this
DEBUG=False
ALLOWED_HOSTS=hijbullah.me,www.hijbullah.me
DATABASE_URL=postgresql://user:password@host:5432/dbname
CORS_ALLOWED_ORIGINS=https://hijbullah.me,https://www.hijbullah.me
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=https://hijbullah.me,https://www.hijbullah.me
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# File Upload Limits (in bytes)
MAX_IMAGE_UPLOAD_SIZE=5242880
MAX_DOCUMENT_UPLOAD_SIZE=10485760

PAGE_SIZE=10
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Media Storage (Cloudinary URL or Leave blank for local filesystem storage)
CLOUDINARY_URL=
